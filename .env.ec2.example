# =============================================
# MobiTrak Backend — EC2 Production Environment
# =============================================
# Copy this file to .env on your EC2 instance and fill in real values.
# NEVER commit this file with real secrets to git.
#
# Usage: cp .env.ec2.example .env && nano .env

# --- Node Environment ---
NODE_ENV=production

# --- MongoDB Configuration ---
# Use your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/mobitrak?appName=Cluster0

# --- JWT Configuration ---
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id_here

# --- SMTP Email Configuration ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=MobiTrak <your_email@gmail.com>

# --- Cloudinary Configuration ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- OCR.space API Keys ---
OCR_SPACE_API_KEY_USER=your_ocr_api_key_for_user_service
OCR_SPACE_API_KEY_VEHICLE=your_ocr_api_key_for_vehicle_service

# --- OpenRouter AI Configuration ---
OPENROUTER_API_KEY_USER=your_openrouter_key_for_user_service
OPENROUTER_API_KEY_VEHICLE=your_openrouter_key_for_vehicle_service
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=openai/gpt-4o-mini

# --- Mapbox Configuration ---
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# --- Razorpay (reserved for future implementation) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Service Ports ---
# These must match the ports in ecosystem.config.js and nginx.conf
USER_SERVICE_PORT=5001
VEHICLE_SERVICE_PORT=5002
DRIVER_SERVICE_PORT=5003
TRIP_SERVICE_PORT=5004

# --- Inter-service URLs (EC2 — all services on localhost) ---
# On EC2, services run on the same machine, so they talk via localhost.
# This replaces the API Gateway URLs used in Lambda deployment.
USER_SERVICE_URL=http://localhost:5001
NOTIFICATION_SERVICE_URL=http://localhost:5001
TRIP_SERVICE_URL=http://localhost:5004
VEHICLE_SERVICE_URL=http://localhost:5002

# --- Frontend / CORS Configuration ---
# Replace with your actual frontend URL (Vercel deployment)
FRONTEND_URL=https://mobitrakapp.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,https://mobitrakapp.vercel.app

# --- Pusher Real-time Configuration ---
# Note: On EC2, Socket.IO works natively (unlike Lambda).
# Pusher is still used by some real-time relay endpoints.
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=ap2
